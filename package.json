{
  "name": "fossil-scan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/server.cjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "dev:scan": "concurrently \"node server/server.cjs\" \"vite --host 0.0.0.0\" \"./.venv/bin/python scripts/rfid-reader.py\" \"./.venv/bin/python scripts/esp32-led-bridge.py\"",
    "rfid": "./.venv/bin/python scripts/rfid-reader.py",
    "start": "node server/server.cjs",
    "kiosk": "bash scripts/start-kiosk.sh",
    "esp": "./.venv/bin/python scripts/esp32-led-bridge.py"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
